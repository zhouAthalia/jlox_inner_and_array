class DevonshireCream {
  serveOn() {
    return "Scones";
  }
}
print DevonshireCream;
var c = DevonshireCream();
print c;
print c.serveOn();

class Bagel {}
var bagel = Bagel();
bagel.topping = "lox";
print bagel.topping;

class Person {
  sayName() { print this.name; }
}
var jane = Person();
jane.name = "Jane";
var bill = Person();
bill.name = "Bill";
bill.sayName = jane.sayName;
bill.sayName();

class Egotist {
  speak() { print this; }
}
var m = Egotist().speak;
m();

class Circle {
  init(radius) { this.radius = radius; }
  area() { return 3 * this.radius * this.radius; }
}
var circle = Circle(4);
print circle.area();
print circle.init(5);
print circle.radius;

class Foo { init() { return; } }
print Foo().init();

fun notAMethod() { print "plain fn"; }
notAMethod();
